import tensorflow as tf
import tf2onnx
import yaml
import os

# Load configs
config_path = "Models/captcha_to_text/202502201804/configs.yaml"
with open(config_path, 'r') as file:
    configs = yaml.safe_load(file)

# Load the model
model_path = os.path.join(configs['model_path'], "model.h5")
model = tf.keras.models.load_model(model_path)

# Convert the model to ONNX
input_signature = [tf.TensorSpec(model.inputs[0].shape, model.inputs[0].dtype)]
onnx_model, _ = tf2onnx.convert.from_keras(model, input_signature)

# Save the ONNX model
onnx_path = os.path.join(configs['model_path'], "model.onnx")
with open(onnx_path, "wb") as f:
    f.write(onnx_model.SerializeToString())

print(f"Model converted to ONNX and saved at: {onnx_path}")
